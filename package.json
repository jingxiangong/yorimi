{
  "name": "tomoni-app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "test:all-events": "node --test tests/events/allEventsPage.test.mjs",
    "open-data:edogawa-events": "node scripts/open-data/importEdogawaEvents.ts",
    "open-data:edogawa-flea-markets": "node scripts/open-data/importEdogawaFleaMarkets.ts",
    "open-data:edogawa-public-places": "node scripts/open-data/importEdogawaPublicPlaces.ts",
    "test:integration": "node --env-file-if-exists=.env.local scripts/test-integration.mjs",
    "test:browser": "node --env-file-if-exists=.env.local --test tests/e2e/emailOnboarding.e2e.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.0",
    "cheerio": "^1.2.0",
    "csv-parse": "^7.0.2",
    "next": "^16.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/google.maps": "^3.65.5",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "puppeteer": "^25.4.0",
    "supabase": "^2.111.0",
    "typescript": "^6.0.3"
  }
}
